
import { createFileRoute } from "@tanstack/react-router";
import { useEffect, useState, type ChangeEvent } from "react";
import {
  Activity,
  AlertCircle,
  CheckCircle2,
  FileImage,
  Loader2,
  ScanEye,
  ShieldCheck,
  UploadCloud,
  X,
} from "lucide-react";

import {
  EmptyState,
  Panel,
  PageHeader,
  QualityBadge,
} from "@/components/sans/ui";
import { OctView } from "@/components/sans/OctView";
import { useDataset } from "@/lib/sans/store";
import { pageHead } from "@/lib/sans/head";
import { cn } from "@/lib/utils";
import type { Eye, Scan } from "@/lib/sans/types";

export const Route = createFileRoute("/app/scans")({
  head: () =>
    pageHead(
      "OCT Eye Scans",
      "AI-powered OCT image classification and independent eye monitoring."
    ),
  component: Scans,
});

type OctResult = {
  module: string;
  prediction: string;
  confidence: number;
  probabilities: Record<string, number>;
  model: string;
};

function formatPercent(value: number) {
  if (!Number.isFinite(value)) return "—";
  return `${(value * 100).toFixed(1)}%`;
}

function EyeColumn({
  eye,
  scans,
}: {
  eye: Eye;
  scans: Scan[];
}) {
  const usable = scans.filter((s) => s.rnfl != null);

  const [sel, setSel] = useState<string | undefined>(
    usable.at(-1)?.id
  );

  const cur =
    scans.find((s) => s.id === sel) ?? usable.at(-1);

  return (
    <Panel
      eyebrow={
        eye === "OD" ? "Oculus dexter" : "Oculus sinister"
      }
      title={
        <span>
          <span
            className={
              eye === "OD" ? "text-od" : "text-os"
            }
          >
            {eye}
          </span>
          {" · "}
          {eye === "OD" ? "Right eye" : "Left eye"}
        </span>
      }
    >
      {cur && cur.rnfl != null ? (
        <>
          <OctView
            eye={eye}
            thickness={cur.rnfl}
            signal={cur.signal}
          />

          <div className="mt-3 grid grid-cols-3 gap-2 text-center">
            <div className="rounded-lg border border-border/60 p-2">
              <p className="eyebrow !text-[9px]">
                RNFL
              </p>
              <p className="font-display text-lg tabular-nums">
                {cur.rnfl}
              </p>
            </div>

            <div className="rounded-lg border border-border/60 p-2">
              <p className="eyebrow !text-[9px]">
                Day
              </p>
              <p className="font-display text-lg">
                D{cur.day}
              </p>
            </div>

            <div className="rounded-lg border border-border/60 p-2">
              <p className="eyebrow !text-[9px]">
                Quality
              </p>
              <div className="mt-1">
                <QualityBadge q={cur.quality} />
              </div>
            </div>
          </div>
        </>
      ) : (
        <EmptyState
          title="No usable scan"
          body="Acquire an OCT volume to populate this eye."
        />
      )}

      <div className="mt-4 max-h-80 overflow-auto rounded-lg border border-border/60">
        <table className="w-full text-sm">
          <caption className="sr-only">
            {eye} scan history
          </caption>

          <thead className="sticky top-0 bg-popover">
            <tr className="eyebrow text-left">
              <th className="px-3 py-2 font-normal">
                Scan
              </th>
              <th className="font-normal">
                RNFL
              </th>
              <th className="font-normal">
                SSI
              </th>
              <th className="font-normal">
                Flag
              </th>
            </tr>
          </thead>

          <tbody>
            {[...scans].reverse().map((s) => (
              <tr
                key={s.id}
                onClick={() =>
                  s.rnfl != null && setSel(s.id)
                }
                tabIndex={s.rnfl != null ? 0 : -1}
                onKeyDown={(e) =>
                  e.key === "Enter" &&
                  s.rnfl != null &&
                  setSel(s.id)
                }
                className={cn(
                  "cursor-pointer border-t border-border/50 font-mono text-xs transition-colors hover:bg-accent/40",
                  cur?.id === s.id && "bg-primary/10"
                )}
              >
                <td className="px-3 py-2">
                  D{s.day}
                  {s.source === "upload" && (
                    <span className="ml-1 text-primary">
                      ↑
                    </span>
                  )}
                </td>

                <td>{s.rnfl ?? "—"}</td>
                <td>{s.signal || "—"}</td>

                <td>
                  <QualityBadge q={s.quality} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Panel>
  );
}

function RealOctAnalysis() {
  const [file, setFile] = useState<File | null>(null);
  const [preview, setPreview] = useState<string | null>(
    null
  );
  const [result, setResult] = useState<OctResult | null>(
    null
  );
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(
    null
  );

  useEffect(() => {
    if (!file) {
      setPreview(null);
      return;
    }

    const url = URL.createObjectURL(file);
    setPreview(url);

    return () => URL.revokeObjectURL(url);
  }, [file]);

  function handleFile(
    event: ChangeEvent<HTMLInputElement>
  ) {
    const selected =
      event.target.files?.[0] ?? null;

    setResult(null);
    setError(null);

    if (!selected) {
      setFile(null);
      return;
    }

    const validTypes = [
      "image/jpeg",
      "image/png",
    ];

    if (!validTypes.includes(selected.type)) {
      setFile(null);
      setError(
        "Please select a PNG or JPEG OCT image."
      );
      return;
    }

    if (selected.size > 10 * 1024 * 1024) {
      setFile(null);
      setError(
        "Image size must not exceed 10 MB."
      );
      return;
    }

    setFile(selected);
  }

  function clearFile() {
    setFile(null);
    setResult(null);
    setError(null);
  }

  async function analyze() {
    if (!file || loading) return;

    setLoading(true);
    setError(null);
    setResult(null);

    try {
      const formData = new FormData();
      formData.append("file", file);

      const response = await fetch(
        "/api/oct/oct/analyze",
        {
          method: "POST",
          body: formData,
        }
      );

      if (!response.ok) {
        let message = `Analysis failed (HTTP ${response.status}).`;

        try {
          const body = await response.json();
          if (typeof body.detail === "string") {
            message = body.detail;
          }
        } catch {
          // Keep the HTTP error message.
        }

        throw new Error(message);
      }

      const data: OctResult =
        await response.json();

      if (
        typeof data.prediction !== "string" ||
        typeof data.confidence !== "number" ||
        !data.probabilities ||
        typeof data.probabilities !== "object"
      ) {
        throw new Error(
          "The AI service returned an unexpected response."
        );
      }

      setResult(data);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to analyze the image."
      );
    } finally {
      setLoading(false);
    }
  }

  return (
    <div className="overflow-hidden rounded-xl border border-primary/25 bg-card/80">
      <div className="border-b border-border/60 bg-primary/5 px-5 py-5 sm:px-6">
        <div className="flex flex-wrap items-start justify-between gap-4">
          <div className="flex items-start gap-3">
            <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-primary/20 bg-primary/10">
              <ScanEye className="h-5 w-5 text-primary" />
            </div>

            <div>
              <p className="eyebrow">
                AI DIAGNOSTIC ASSISTANCE
              </p>

              <h2 className="mt-1 font-display text-xl font-semibold">
                OCT Image Analysis
              </h2>

              <p className="mt-1 max-w-xl text-sm text-muted-foreground">
                Upload an OCT image to run inference
                using the trained SANSIGHT model.
              </p>
            </div>
          </div>

          <span className="inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary">
            <Activity className="h-3.5 w-3.5" />
            Trained AI
          </span>
        </div>
      </div>

      <div className="grid gap-5 p-5 sm:p-6 lg:grid-cols-2">
        <div className="space-y-4">
          <label
            htmlFor="oct-ai-file"
            className="flex min-h-52 cursor-pointer flex-col items-center justify-center rounded-xl border border-dashed border-primary/35 bg-primary/[0.03] px-5 py-8 text-center transition-colors hover:border-primary/70 hover:bg-primary/[0.06]"
          >
            <UploadCloud className="mb-3 h-9 w-9 text-primary" />

            <span className="text-sm font-semibold">
              Select OCT Image
            </span>

            <span className="mt-2 text-xs text-muted-foreground">
              PNG or JPEG · Maximum 10 MB
            </span>

            <input
              id="oct-ai-file"
              type="file"
              accept="image/png,image/jpeg"
              onChange={handleFile}
              className="sr-only"
            />
          </label>

          {file && (
            <div className="flex items-center justify-between gap-3 rounded-lg border border-border/70 bg-muted/30 p-3">
              <div className="flex min-w-0 items-center gap-3">
                <FileImage className="h-5 w-5 shrink-0 text-primary" />

                <div className="min-w-0">
                  <p className="truncate text-sm font-medium">
                    {file.name}
                  </p>

                  <p className="text-xs text-muted-foreground">
                    {(file.size / 1024 / 1024).toFixed(2)} MB
                  </p>
                </div>
              </div>

              <button
                type="button"
                onClick={clearFile}
                disabled={loading}
                aria-label="Remove selected image"
                className="rounded-md p-2 text-muted-foreground hover:bg-accent hover:text-foreground disabled:opacity-50"
              >
                <X className="h-4 w-4" />
              </button>
            </div>
          )}

          <button
            type="button"
            onClick={analyze}
            disabled={!file || loading}
            className="flex w-full items-center justify-center gap-2 rounded-lg bg-cta px-5 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
          >
            {loading ? (
              <>
                <Loader2 className="h-4 w-4 animate-spin" />
                Running AI Inference...
              </>
            ) : (
              <>
                <ScanEye className="h-4 w-4" />
                Analyze with Trained AI
              </>
            )}
          </button>

          {error && (
            <div
              role="alert"
              className="flex items-start gap-2 rounded-lg border border-destructive/30 bg-destructive/10 p-3 text-sm text-destructive"
            >
              <AlertCircle className="mt-0.5 h-4 w-4 shrink-0" />
              <span>{error}</span>
            </div>
          )}
        </div>

        <div className="flex min-h-72 flex-col overflow-hidden rounded-xl border border-border/70 bg-background/40">
          <div className="flex items-center justify-between border-b border-border/60 px-4 py-3">
            <span className="eyebrow">
              IMAGE PREVIEW
            </span>

            <span className="text-xs text-muted-foreground">
              {file ? "Selected Image" : "Awaiting Image"}
            </span>
          </div>

          <div className="flex min-h-60 flex-1 items-center justify-center p-4">
            {preview ? (
              <img
                src={preview}
                alt="Selected OCT image for AI analysis"
                className="max-h-80 max-w-full rounded-lg object-contain"
              />
            ) : (
              <div className="text-center">
                <ScanEye className="mx-auto h-12 w-12 text-muted-foreground/30" />

                <p className="mt-3 text-sm text-muted-foreground">
                  Your OCT image will appear here.
                </p>
              </div>
            )}
          </div>
        </div>
      </div>

      {result && (
        <div className="border-t border-border/70 px-5 py-5 sm:px-6">
          <div className="mb-4 flex items-center gap-2">
            <CheckCircle2 className="h-5 w-5 text-primary" />

            <h3 className="font-display text-lg font-semibold">
              AI Analysis Complete
            </h3>
          </div>

          <div className="grid gap-4 md:grid-cols-2">
            <div className="rounded-xl border border-primary/25 bg-primary/5 p-5">
              <p className="eyebrow">
                MODEL PREDICTION
              </p>

              <p className="mt-3 break-words font-display text-2xl font-semibold">
                {result.prediction}
              </p>

              <p className="mt-4 text-xs text-muted-foreground">
                Classification generated by the trained
                OCT neural network.
              </p>
            </div>

            <div className="rounded-xl border border-border/70 bg-muted/20 p-5">
              <p className="eyebrow">
                MODEL CONFIDENCE
              </p>

              <p className="mt-3 font-display text-3xl font-semibold tabular-nums text-primary">
                {formatPercent(result.confidence)}
              </p>

              <div className="mt-4 h-2 overflow-hidden rounded-full bg-muted">
                <div
                  className="h-full rounded-full bg-primary transition-all"
                  style={{
                    width: `${Math.max(
                      0,
                      Math.min(100, result.confidence * 100)
                    )}%`,
                  }}
                />
              </div>
            </div>
          </div>

          <div className="mt-4 rounded-xl border border-border/70 p-5">
            <h4 className="text-sm font-semibold">
              Classification Probabilities
            </h4>

            <div className="mt-4 space-y-4">
              {Object.entries(result.probabilities).map(
                ([label, probability]) => (
                  <div key={label}>
                    <div className="mb-2 flex justify-between gap-3 text-sm">
                      <span>{label}</span>

                      <span className="font-mono tabular-nums text-muted-foreground">
                        {formatPercent(probability)}
                      </span>
                    </div>

                    <div className="h-2 overflow-hidden rounded-full bg-muted">
                      <div
                        className="h-full rounded-full bg-primary/80"
                        style={{
                          width: `${Math.max(
                            0,
                            Math.min(100, probability * 100)
                          )}%`,
                        }}
                      />
                    </div>
                  </div>
                )
              )}
            </div>
          </div>

          <div className="mt-4 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
            <ShieldCheck className="h-4 w-4" />
            <span>
              Model: {result.model}
            </span>
          </div>

          <p className="mt-3 text-xs leading-relaxed text-muted-foreground">
            AI classification is intended for research
            demonstration only and is not a clinical
            diagnosis. Results are separate from the
            simulated RNFL measurements below.
          </p>
        </div>
      )}
    </div>
  );
}

function Scans() {
  const { data, range } = useDataset();

  const from = data.currentDay - range;

  return (
    <div className="space-y-6">
      <PageHeader
        eyebrow="Optical coherence tomography"
        title="OCT Eye Scans"
        description="AI-powered OCT classification and independent longitudinal monitoring of both eyes."
      />

      <RealOctAnalysis />

      <div className="space-y-4">
        <div>
          <p className="eyebrow">
            LONGITUDINAL MONITORING
          </p>

          <h2 className="mt-1 font-display text-xl font-semibold">
            Eye Scan History
          </h2>

          <p className="mt-1 text-sm text-muted-foreground">
            Independent right-eye and left-eye RNFL
            tracking. The scan renderings and historical
            measurements below are simulated.
          </p>
        </div>

        <div className="grid gap-4 lg:grid-cols-2">
          {(["OD", "OS"] as Eye[]).map((eye) => (
            <EyeColumn
              key={`${eye}-${data.astronaut.id}`}
              eye={eye}
              scans={data.scans.filter(
                (scan) =>
                  scan.eye === eye &&
                  scan.day >= from
              )}
            />
          ))}
        </div>
      </div>
    </div>
  );
}
